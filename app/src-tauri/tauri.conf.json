{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daydream",
  "version": "1.5.0",
  "identifier": "com.vitalrtech.daydream",
  "build": {
    "beforeDevCommand": "node sync.mjs",
    "beforeBuildCommand": "node sync.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Daydream",
        "width": 1200,
        "height": 780,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Daydream music player",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
